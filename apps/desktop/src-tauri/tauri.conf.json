{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Autonomi Video Management",
  "version": "0.1.0",
  "identifier": "com.autonomi.video-management",
  "build": {
    "beforeDevCommand": "cd ../web && npm run start -- --host 127.0.0.1",
    "beforeBuildCommand": "cd ../web && npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/build"
  },
  "app": {
    "windows": [
      {
        "title": "Autonomi Video Management",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; worker-src 'self' blob:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "Video",
    "shortDescription": "Local Autonomi video management app",
    "longDescription": "Upload, transcode, publish, and play HLS video backed by the Autonomi network.",
    "externalBin": [
      "binaries/antd",
      "binaries/rust_admin",
      "binaries/rust_stream",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "resources": {
      "../../web/build/": "frontend/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": null,
      "exceptionDomain": "127.0.0.1"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/bundle/32x32.png",
      "icons/bundle/128x128.png",
      "icons/bundle/128x128@2x.png",
      "icons/bundle/icon.icns",
      "icons/bundle/icon.ico"
    ]
  },
  "plugins": {}
}
